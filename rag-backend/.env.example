# Copy this file to .env in the same folder. Spring Boot reads it at startup.
# Use the same password as DB_PASSWORD in ../.env (docker compose)
SPRING_DATASOURCE_PASSWORD=change-me

# Optional: must match MODEL_API_KEY in rag-model-service/.env if you set one there
MODEL_SERVICE_API_KEY=

# Typhoon API key from https://playground.opentyphoon.ai (never commit the real key)
TYPHOON_API_KEY=

# Experiments for eval (restart backend after changing). Defaults shown.
# CHAT_TOP_K=5
# CHAT_MIN_SCORE=0.35
# CHAT_SOURCE_FORMAT=tagged
# CHAT_VERIFY_CITATIONS=true
