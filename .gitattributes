# Normalize line endings in the repo; check out with the OS default
* text=auto

# Shell scripts must keep LF (used inside Linux containers in week 4)
mvnw text eol=lf
*.sh text eol=lf

# Windows scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.pdf binary
*.ico binary
*.png binary
