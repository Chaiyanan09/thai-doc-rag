# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ไฟล์ .env ไม่ถูก commit)

# ที่เก็บโมเดลที่ดาวน์โหลดจาก Hugging Face (bge-m3 ประมาณ 2.3 GB)
# ตั้งไว้ที่ไดร์ฟ D เพราะค่าเริ่มต้นจะไปอยู่ที่ไดร์ฟ C
HF_HOME=D:\ThaiDocRAG\hf-cache

EMBED_MODEL=BAAI/bge-m3
# ว่างไว้ = เลือกเอง (มี GPU ใช้ cuda), หรือใส่ cpu / cuda
EMBED_DEVICE=
EMBED_BATCH_SIZE=16
PRELOAD_MODEL=true

CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=150
MAX_UPLOAD_MB=30

# ถ้าใส่ค่า Spring Boot ต้องส่ง header X-API-KEY ค่าเดียวกัน (MODEL_SERVICE_API_KEY ฝั่ง backend)
MODEL_API_KEY=
